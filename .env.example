VITE_API_URL=http://localhost:4000
# El backend expone la API y el WebSocket sobre el mismo puerto (ver
# services/websocket.js en el backend) — mismo host que VITE_API_URL, solo
# cambia el esquema (ws/wss en vez de http/https). En producción, por ejemplo
# wss://piura-alerta-api.onrender.com.
VITE_WS_URL=ws://localhost:4000

# Cuenta gratuita en https://cloudinary.com — crear un "unsigned upload
# preset" en Settings > Upload > Upload presets para poder usar estos valores.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
