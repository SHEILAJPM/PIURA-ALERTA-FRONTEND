VITE_API_URL=http://localhost:4000
# El backend expone la API y el WebSocket sobre el mismo puerto (ver
# src/servicios/websocket.js en el backend) — mismo host que VITE_API_URL,
# solo cambia el esquema (ws/wss en vez de http/https). En producción, por
# ejemplo wss://piura-alerta-api.onrender.com.
VITE_WS_URL=ws://localhost:4000

# Cuenta gratuita en https://cloudinary.com — crear un "unsigned upload
# preset" en Settings > Upload > Upload presets para poder usar estos valores.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Clave gratis e instantánea en carto.com/basemaps/apikey (sin necesitar
# cuenta, 5 millones de tiles/mes gratis) para el mapa de RiesgoMap.jsx con
# estilo claro/oscuro a juego con el tema de la app. Si se deja vacío, el
# mapa usa OpenStreetMap como respaldo (siempre gratis, sin clave) — se ve
# distinto y sin variante oscura, pero nunca queda roto ni con marca de agua.
VITE_CARTO_API_KEY=
